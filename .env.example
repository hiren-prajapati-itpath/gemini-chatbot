# Gemini Caching Chatbot Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# CORE CONFIGURATION (REQUIRED)
# ============================================================================

# Google Gemini AI API Key (Required)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash-001

# Application Configuration
PORT=3000
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=gemini_cache_db
DB_PORT=5432

# Alternative Database URL format (if using cloud providers)
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================================
# SMART CONTEXT SUMMARIZATION (OPTIONAL)
# ============================================================================

# Enable/disable smart context optimization for token savings
# Set to 'false' to disable summarization entirely
ENABLE_SMART_SUMMARIZATION=true

# Number of recent messages to keep intact (not summarized)
# Higher values = better context retention, more tokens used
# Lower values = more token savings, less detailed recent context
RECENT_MESSAGES_COUNT=10

# Minimum messages required before summarization kicks in
# Conversations shorter than this will not be summarized
MIN_MESSAGES_FOR_SUMMARY=15

# ============================================================================
# TOKEN PRICING CONFIGURATION (OPTIONAL)
# ============================================================================
# Pricing in USD per 1 million tokens
# Update these if Google changes their pricing

# Input token cost (user messages + context)
GEM_INPUT_PER_MTOK=0.10

# Output token cost (AI responses)
GEM_OUTPUT_PER_MTOK=0.40

# One-time cache creation cost
GEM_CACHE_CREATE_PER_MTOK=0.025

# Cache storage cost per hour
GEM_CACHE_STORAGE_PER_MTOK_PER_HR=1.0

# ============================================================================
# CACHE & SESSION CONFIGURATION (OPTIONAL)
# ============================================================================

# Cache time-to-live (how long caches persist)
# Format: number + 's' for seconds, 'h' for hours
# Examples: 3600s (1 hour), 8h (8 hours), 86400s (24 hours)
CACHE_TTL=28800s

# Redis Configuration (for session storage)
REDIS_URL=redis://localhost:6379
SESSION_STORAGE_TYPE=redis  # Options: redis, memory

# Session Configuration
SESSION_TTL_HOURS=24  # Session timeout in hours
SESSION_CLEANUP_INTERVAL=3600  # Cleanup interval in seconds

# ============================================================================
# STORAGE & UPLOAD CONFIGURATION (OPTIONAL)
# ============================================================================

# Storage Configuration
UPLOAD_DIR=uploads  # Directory for file uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes

# ============================================================================
# FEATURE FLAGS (OPTIONAL)
# ============================================================================

# Analytics and Monitoring
ENABLE_TOKEN_ANALYTICS=true
ENABLE_SESSION_PERSISTENCE=true
ENABLE_CACHE_METRICS=true

# Development Features
DEMO_MODE=true

# Logging
LOG_LEVEL=info  # Options: error, warn, info, debug

# ============================================================================
# DEPLOYMENT CONFIGURATION (OPTIONAL)
# ============================================================================

# Set to true when deploying to Render
# RENDER=true

# Security (for production)
# JWT_SECRET=your_jwt_secret_here
# CORS_ORIGIN=https://yourdomain.com

# ============================================================================
# PRODUCTION OVERRIDES
# ============================================================================
# Uncomment these for production deployment:

# NODE_ENV=production
# SESSION_STORAGE_TYPE=redis
# CACHE_TTL=86400s  # 24 hours
# ENABLE_SMART_SUMMARIZATION=true
# RECENT_MESSAGES_COUNT=8
# MIN_MESSAGES_FOR_SUMMARY=12
